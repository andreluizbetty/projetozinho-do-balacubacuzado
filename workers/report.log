CREATE TABLE notas_fiscais (
	id SERIAL NOT NULL, 
	numero VARCHAR(50) NOT NULL, 
	serie VARCHAR(10) NOT NULL, 
	chave VARCHAR(44) NOT NULL, 
	data_emissao VARCHAR(30) NOT NULL, 
	tipo INTEGER NOT NULL, 
	cnpj_emitente VARCHAR(14) NOT NULL, 
	razao_social_emitente VARCHAR(200) NOT NULL, 
	cnpj_destinatario VARCHAR(14) NOT NULL, 
	razao_social_destinatario VARCHAR(200) NOT NULL, 
	valor_produtos NUMERIC(10, 2), 
	valor_desconto NUMERIC(10, 2), 
	valor_frete NUMERIC(10, 2), 
	valor_seguro NUMERIC(10, 2), 
	valor_icms NUMERIC(10, 2), 
	valor_ipi NUMERIC(10, 2), 
	valor_pis NUMERIC(10, 2), 
	valor_cofins NUMERIC(10, 2), 
	valor_total NUMERIC(10, 2) NOT NULL, 
	protocolo VARCHAR(50) NOT NULL, 
	status INTEGER NOT NULL, 
